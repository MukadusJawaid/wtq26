# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js / build output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# tests
/coverage

# secrets: keep the template, never the real file
.env*
!.env.example

# os / editor / logs
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# generated by the batch run: results and per-bill checkpoints
/output/

# competition inputs: the bill images are large and provided at the event; the two small CSV templates
# are kept so the app (and a deployment) can preselect them
/test/bills/*
!/test/bills/.gitkeep

# the submission ZIP built by `npm run package`
/submission/
